    "type": "library",
    "keywords": ["dobre", "laravel", "glassmorphism", "blade-components", "autocomplete", "ui", "ihc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dobre Tecnologia",
            "email": "contato@dobretecnologia.com",
            "homepage": "https://dobretecnologia.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/view": "^9.0|^10.0|^11.0",
        "illuminate/routing": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dobre\\Widgets\\": "src/"
        }
